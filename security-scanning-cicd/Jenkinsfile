pipeline {
    agent {
        label 'jenkins-agent'
    }

    stages {

        stage('Setup Python') {
            steps {
                dir('security-scanning-cicd') {
                    sh '''
                       rm -rf .venv
                       mise exec -- uv venv .venv
                       mise exec -- uv pip install --python .venv/bin/python -r requirements.txt

                    '''
                }
            }
        }

        stage('Test') {
            steps {
                dir('security-scanning-cicd') {
                    sh './scripts/test.sh'
                }
            }
        }

        stage('Source Security Scan') {
            steps {
                dir('security-scanning-cicd') {
                    sh './scripts/security-scan.sh'
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('security-scanning-cicd') {
                    sh 'mise exec -- docker build -t security-scanning-cicd:${BUILD_NUMBER} .'
                }
            }
        }

        stage('Trivy Container Scan') {
            steps {
                dir('security-scanning-cicd') {
                    sh '''
                        
                        mkdir -p .docker
                        printf '{"auths":{}}\\n' > .docker/config.json

                        DOCKER_CONFIG="$PWD/.docker" \
                        mise exec -- trivy image \
                          --severity HIGH,CRITICAL \
                          --exit-code 1 \
                          security-scanning-cicd:${BUILD_NUMBER}
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Security pipeline completed successfully.'
        }

        failure {
            echo 'Security pipeline failed.'
        }

        always {
            echo 'Pipeline execution finished.'
        }
    }
}
